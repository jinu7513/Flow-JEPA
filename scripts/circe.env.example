# Source in CIRCE Bash after installing a dedicated Flow-JEPA environment.
# Replace every /ABSOLUTE/... path. Do not use AdaJEPA output directories.
export FLOWJEPA_REPO=/ABSOLUTE/PATH/Flow-JEPA
export FLOWJEPA_PYTHON=/ABSOLUTE/PATH/Flow-JEPA/.venv-circe/bin/python
export FLOWJEPA_DATA_ROOT=/ABSOLUTE/WORK/PATH/flow-jepa-data
export FLOWJEPA_RUNS_ROOT=/ABSOLUTE/PERSISTENT/PATH/flow-jepa-runs
export FLOWJEPA_LOG_ROOT=/ABSOLUTE/PERSISTENT/PATH/flow-jepa-logs
export FLOWJEPA_RUN_ID=flowjepa-pusht-NEW-UNIQUE-ID
# Historical candidates: verify current association, partition and QoS first.
export FLOWJEPA_PARTITION=muma_2021
export FLOWJEPA_QOS=preempt_short
# Choose full-run walltime only after inspecting the current QoS limit.
export FLOWJEPA_TIME=00:15:00
export FLOWJEPA_BATCH_SIZE=8
export FLOWJEPA_PRECISION=16-mixed # bf16-mixed only after confirming GPU support
export FLOWJEPA_WORKERS=6
export FLOWJEPA_CHECKPOINT_STEPS=100
export FLOWJEPA_WANDB=0
# export FLOWJEPA_ACCOUNT=YOUR_ACCOUNT
# export WANDB_ENTITY=YOUR_ENTITY
# export WANDB_MODE=online

# After training: three-condition deployment evaluation (separate output ID).
# export FLOWJEPA_EVAL_CHECKPOINT=/ABSOLUTE/PATH/TO/TRAINED/weights_epoch_20.pt
# export FLOWJEPA_EVAL_ID=flowjepa-eval-pusht-NEW-ID
# export FLOWJEPA_EVAL_TIME=00:15:00 # smoke first; choose full walltime after timing
# export FLOWJEPA_EVAL_SEED=42
